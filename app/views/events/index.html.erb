<!-- app/views/events/index.html.erb -->
<div class="min-h-screen bg-gray-50 py-8">
  <!-- Header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Upcoming Events</h1>
        <p class="mt-1 text-sm text-gray-500">Discover and vote for your favorite events</p>
      </div>
      <div class="flex space-x-2">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
          <%= @events.count %> Events
        </span>
      </div>
    </div>
  </div>

  <!-- Event Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @events.each do |event| %>
        <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden group">
          <!-- Image Section -->
          <div class="relative h-48 overflow-hidden">
            <% if event[:image_link].present? %>
              <img 
                src="<%= event[:image_link] %>" 
                alt="<%= event[:title] %>"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              >
            <% else %>
              <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
                <span class="text-gray-400">No image</span>
              </div>
            <% end %>
            
            <!-- Category Badge -->
            <span class="absolute top-3 right-3 px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-semibold text-gray-700 shadow-sm">
              <%= event[:category] %>
            </span>
            
            <!-- Price Badge -->
            <span class="absolute bottom-3 left-3 px-3 py-1 bg-green-500 text-white rounded-full text-xs font-semibold shadow-md">
              <%= event[:price] %>
            </span>
          </div>

          <!-- Content Section -->
          <div class="p-5">
            <!-- Title -->
            <h3 class="text-lg font-bold text-gray-900 mb-1 line-clamp-2">
              <%= event[:title] %>
            </h3>

            <!-- Location -->
            <div class="flex items-center text-sm text-gray-500 mb-2">
              <svg class="w-4 h-4 mr-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span class="truncate"><%= event[:location] %></span>
            </div>

            <!-- Date -->
            <div class="flex items-center text-sm text-gray-500 mb-3">
              <svg class="w-4 h-4 mr-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span>
                <%= Time.parse(event[:start_date]).strftime("%b %d, %Y • %I:%M %p") %>
              </span>
            </div>

            <!-- Description -->
            <p class="text-sm text-gray-600 mb-4 line-clamp-2">
              <%= truncate(event[:description], length: 100) %>
            </p>

            <!-- Divider -->
            <div class="border-t border-gray-100 pt-4">
              <!-- Vote Buttons -->
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <!-- Like Button -->
                  <button 
                    class="vote-btn like-btn flex items-center space-x-1 px-3 py-1.5 rounded-full bg-gray-100 hover:bg-green-100 transition-colors duration-200 text-gray-600 hover:text-green-600"
                    data-event-id="<%= event[:id] %>"
                    data-vote-type="like"
                  >
                    <span class="text-lg">👍</span>
                    <span class="like-count text-sm font-medium"><%= event[:likes] %></span>
                  </button>

                  <!-- Dislike Button -->
                  <button 
                    class="vote-btn dislike-btn flex items-center space-x-1 px-3 py-1.5 rounded-full bg-gray-100 hover:bg-red-100 transition-colors duration-200 text-gray-600 hover:text-red-600"
                    data-event-id="<%= event[:id] %>"
                    data-vote-type="dislike"
                  >
                    <span class="text-lg">👎</span>
                    <span class="dislike-count text-sm font-medium"><%= event[:dislikes] %></span>
                  </button>
                </div>

                <!-- View Details Link -->
                <%= link_to "Event", class: "text-sm text-blue-600 hover:text-blue-800 font-medium" do %>
                  Details →
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Empty State -->
    <% if @events.empty? %>
      <div class="text-center py-12">
        <div class="text-6xl mb-4">🎫</div>
        <h3 class="text-xl font-medium text-gray-900 mb-2">No events found</h3>
        <p class="text-gray-500">Check back later for new events</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Custom Styles for Line Clamp -->
<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .vote-btn.voted {
    transform: scale(1.05);
  }
  
  .vote-btn.like-btn.voted {
    background-color: #d1fae5;
    color: #065f46;
  }
  
  .vote-btn.dislike-btn.voted {
    background-color: #fee2e2;
    color: #991b1b;
  }
</style>

<!-- JavaScript for Voting -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const voteButtons = document.querySelectorAll('.vote-btn');
    
    voteButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        
        const card = this.closest('.bg-white');
        const likeCount = card.querySelector('.like-count');
        const dislikeCount = card.querySelector('.dislike-count');
        const likeBtn = card.querySelector('.like-btn');
        const dislikeBtn = card.querySelector('.dislike-btn');
        
        // Parse current counts
        let likes = parseInt(likeCount.textContent) || 0;
        let dislikes = parseInt(dislikeCount.textContent) || 0;
        
        // Toggle vote
        if (this.classList.contains('voted')) {
          // Remove vote
          if (this === likeBtn) {
            likes = Math.max(0, likes - 1);
          } else {
            dislikes = Math.max(0, dislikes - 1);
          }
          this.classList.remove('voted');
        } else {
          // Add vote
          if (this === likeBtn) {
            if (dislikeBtn.classList.contains('voted')) {
              dislikes = Math.max(0, dislikes - 1);
              dislikeBtn.classList.remove('voted');
            }
            likes += 1;
          } else {
            if (likeBtn.classList.contains('voted')) {
              likes = Math.max(0, likes - 1);
              likeBtn.classList.remove('voted');
            }
            dislikes += 1;
          }
          this.classList.add('voted');
        }
        
        // Update counts
        likeCount.textContent = likes;
        dislikeCount.textContent = dislikes;
        
        // Show feedback
        showToast(`${this === likeBtn ? '👍 Liked' : '👎 Disliked'} ${this.dataset.eventId}`);
      });
    });
    
    // Toast notification
    function showToast(message) {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-4 right-4 bg-gray-900 text-white px-6 py-3 rounded-lg shadow-lg transition-opacity duration-500 z-50';
      toast.textContent = message;
      document.body.appendChild(toast);
      
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => {
          toast.remove();
        }, 500);
      }, 2000);
    }
  });
</script>