<!-- Sync Status Section (Wrap in SINGLE data-controller) -->
<div data-controller="sync-status" class="flex flex-col gap-4 mb-4">
  <button 
    data-action="click->sync-status#check"
    class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg text-sm font-medium transition-colors cursor-pointer self-start"
  >
    Check Sync Status
  </button>

  <div 
    data-sync-status-target="display" 
    class="hidden p-4 rounded-lg bg-gray-100 border border-gray-200"
  >
    <div class="flex justify-between items-center">
      <h3 class="text-sm font-semibold text-gray-700">Last Ingestion Status</h3>
      <button 
        data-action="click->sync-status#hide"
        class="text-gray-500 hover:text-gray-700"
      >
        &times;
      </button>
    </div>
    <div data-sync-status-target="content" class="mt-2 text-sm text-gray-600"></div>
  </div>
</div>
<!-- app/views/events/index.html.erb -->
<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Upcoming Events</h1>
        <p class="text-sm text-gray-500 mt-1"><%= @events.count %> events found</p>
      </div>
      <div class="flex gap-2">
        <%= button_to "Sync Recent", ingest_events_path, method: :post, 
            class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors cursor-pointer" %>
        <%= button_to "Sync All", ingest_all_events_path, method: :post, 
            class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors cursor-pointer" %>
      </div>
    </div>

    <!-- Event Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @events.each do |event| %>
        <% user_vote = @user_votes&.dig(event.id) %>
        <div class="event-card bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden" data-controller="voting"  data-event-id="<%= event.id %>">
          <!-- Image Section -->
          <div class="relative h-48 overflow-hidden bg-gray-100">
            <% if event.image_link.present? %>
              <img src="<%= event.image_link %>" alt="<%= event.title %>" class="w-full h-full object-cover">
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-gray-400">No image</div>
            <% end %>
            
            <span class="absolute top-3 right-3 px-3 py-1 bg-white/90 rounded-full text-xs font-semibold text-gray-700">
              <%= event.category || "Uncategorized" %>
            </span>
            <span class="absolute bottom-3 left-3 px-3 py-1 bg-green-500 text-white rounded-full text-xs font-semibold">
              <%= event.formatted_price %>
            </span>
          </div>

          <!-- Content Section -->
          <div class="p-5">
            <h3 class="text-lg font-bold text-gray-900 mb-1 line-clamp-2">
              <%= link_to event.title, "#", class: "hover:text-blue-600" %>
            </h3>

            <div class="flex items-center text-sm text-gray-500 mb-2">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              </svg>
              <span class="truncate"><%= event.location_name || "No location" %></span>
            </div>

            <div class="flex items-center text-sm text-gray-500 mb-3">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span><%= event.start_date.strftime("%b %d, %Y • %I:%M %p") %></span>
            </div>

            <p class="text-sm text-gray-600 mb-4 line-clamp-2">
              <%= truncate(event.description, length: 100) if event.description.present? %>
            </p>

            <!-- Voting Section -->
            <div class="border-t border-gray-100 pt-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-1">
                  <!-- Upvote Button -->
                  <button 
                    class="vote-btn upvote-btn flex items-center space-x-1 px-3 py-1.5 rounded-full transition-all duration-200 
                      <%= user_vote&.vote_type == 'upvote' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600 hover:bg-green-100 hover:text-green-600' %>"
                    data-event-id="<%= event.id %>"
                    data-vote-type="upvote"
                    data-authenticated="<%= user_signed_in? %>"
                    data-action="click->voting#vote"
                  >
                    <span class="text-base">👍</span>
                    <span class="vote-count upvote-count text-sm font-medium"><%= event.upvotes_count %></span>
                  </button>

                  <!-- Downvote Button -->
                  <button 
                    class="vote-btn downvote-btn flex items-center space-x-1 px-3 py-1.5 rounded-full transition-all duration-200 
                      <%= user_vote&.vote_type == 'downvote' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-600 hover:bg-red-100 hover:text-red-600' %>"
                    data-event-id="<%= event.id %>"
                    data-vote-type="downvote"
                    data-authenticated="<%= user_signed_in? %>"
                    data-action="click->voting#vote"
                  >
                    <span class="text-base">👎</span>
                    <span class="vote-count downvote-count text-sm font-medium"><%= event.downvotes_count %></span>
                  </button>

                  <!-- Score -->
                  <span class="vote-score text-sm font-semibold text-gray-500 ml-2 min-w-[20px] text-center">
                    <%= event.total_score %>
                  </span>
                </div>

                <%= link_to "Details →", "#", class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Empty State -->
    <% if @events.empty? %>
      <div class="text-center py-12">
        <div class="text-6xl mb-4">🎫</div>
        <h3 class="text-xl font-medium text-gray-900 mb-2">No events found</h3>
        <p class="text-gray-500">Click "Sync Events" to fetch events from Billetto</p>
      </div>
    <% end %>
  </div>
</div>

