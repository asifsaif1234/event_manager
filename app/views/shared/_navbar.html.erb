<!-- app/views/shared/_navbar.html.erb -->
<nav class="bg-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <div class="flex items-center">
        <%= link_to "EventManager", root_path, class: "text-xl font-bold" %>
      </div>

      <div class="flex items-center space-x-4">
        <% if user_signed_in? %>
          <span class="text-sm"><%= current_user&.first_name || "User" %></span>
          <button 
            type="button"
            class="cursor-pointer" 
            id="sign-out"
            
          >
            Sign Out
          </button>
        <% else %>
          <%= link_to "Sign In", sign_in_path, class: "text-blue-600" %>
          <%= link_to "Sign Up", sign_up_path, class: "px-4 py-2 bg-blue-600 text-white rounded" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>

<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🔍 Checking for Clerk...');
    console.log('🔍 Clerk object:', window.Clerk);
    
    const signOutButton = document.getElementById('sign-out');
    
    if (!signOutButton) {
      console.error('❌ Sign out button not found!');
      return;
    }

    console.log('✅ Sign out button found');

    signOutButton.addEventListener('click', async function(event) {
      event.preventDefault();
      
      console.log('🔵 Sign out clicked');
      console.log('🔍 Clerk available:', !!window.Clerk);
      
      // Check if Clerk is available
      if (!window.Clerk) {
        console.error('❌ Clerk is not initialized');
        // Force redirect
        window.location.href = '/';
        return;
      }

      try {
        console.log('🔄 Calling Clerk.signOut...');
        await window.Clerk.signOut({ redirectUrl: '/' });
        console.log('✅ Sign out successful');
      } catch (error) {
        console.error('❌ Sign out error:', error);
        // Fallback redirect
        window.location.href = '/';
      }
    });
  });
</script>

